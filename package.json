{
  "name": "e-waste-together",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.0",
  "overrides": {
    "handlebars": "4.7.10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run check:backend",
    "check:backend": "tsc -p amplify/tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "sandbox": "ampx sandbox",
    "sandbox:delete": "ampx sandbox delete"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "aws-amplify": "^6.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.20.0",
    "@aws-amplify/backend-cli": "^1.8.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/s3-presigned-post": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.3"
  }
}
